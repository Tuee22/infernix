packages: .
write-ghc-environment-files: never
with-compiler: ghc-9.12.4

-- Bounded host build memory (Phase 1 Sprint 1.21). Canonical doctrine:
-- documents/architecture/bounded_host_memory.md
--
-- A per-process cap is not a host bound on its own. This fresh-clone account is
-- three compiler jobs x 4096 MiB = 12288 MiB, plus four control/helper claims x
-- 1024 MiB = 4096 MiB, for exactly 16384 MiB. `jobs: $ncpus` from an operator's
-- ~/.cabal/config would break that claimant arithmetic, which is the failure
-- mode the doctrine exists for.
--
-- These committed numbers are the floor a fresh clone needs before any
-- `infernix` binary exists. `infernix init` supersedes them per machine by
-- generating the untracked `cabal.project.local` from the host manifest's
-- measured memory facts. 4096 MiB is 3.1x the 1328 MiB peak resident set
-- measured for the largest single compiler process across a complete clean
-- `cabal build all --enable-tests`; -xr bounds the compiler's own address-space
-- reservation, which is 1024.65 GiB by default.
jobs: 3

package *
    ghc-options: +RTS -M4096M -xr12288M -RTS

allow-newer:
    *:base
  , *:template-haskell
  , binary:containers
  , lens-family:base
  , lens-family:containers
  , lens-family:lens-family-core
  , lens-family-core:containers
  , proto-lens:lens-family
