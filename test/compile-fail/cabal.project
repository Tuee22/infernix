packages:
    ../../infernix.cabal
    ./infernix-compile-fixtures.cabal

write-ghc-environment-files: never
with-compiler: ghc-9.12.4

-- Bounded host build memory (Phase 1 Sprint 1.21). Canonical doctrine:
-- documents/architecture/bounded_host_memory.md
--
-- This serialized nested surface has its own closed account: one 2048 MiB GHC
-- plus four 1024 MiB control/auxiliary claimants (outer Cabal, test runner,
-- nested Cabal, and the nested worker auxiliary) totals 6144 MiB, inside the
-- outer 8192 MiB account. Main.hs repeats these exact values as final Cabal
-- arguments so a later project-file read cannot widen them.
jobs: 1

package *
    ghc-options: +RTS -M2048M -xr6144M -RTS

allow-newer:
    *:base
  , *:template-haskell
  , binary:containers
  , lens-family:base
  , lens-family:containers
  , lens-family:lens-family-core
  , lens-family-core:containers
  , proto-lens:lens-family
