cabal-version: 3.8
name: infernix-compile-fixtures
version: 0.1.0.0
build-type: Simple

common fixture
    default-language: GHC2021
    ghc-options:
        -Wall
        -Werror
        -fdiagnostics-color=never
    build-depends:
        base >=4.18 && <4.23,
        infernix,
        text >=2.0 && <2.2

common protocol-fixture
    default-language: GHC2021
    ghc-options:
        -Wall
        -Werror
        -fdiagnostics-color=never
    build-depends:
        aeson >=2.1 && <2.3,
        base >=4.18 && <4.23,
        base16-bytestring >=1.0 && <1.1,
        bytestring >=0.11 && <0.13,
        directory >=1.3 && <1.4,
        entropy >=0.4.1.11 && <0.5,
        filelock >=0.1.1.9 && <0.2,
        filepath >=1.4 && <1.6,
        text >=2.0 && <2.2,
        unix >=2.8 && <2.9
    other-modules:
        Infernix.Cluster.Subprocess.Activity
        Infernix.Cluster.Subprocess.Protocol
        Infernix.Error
        Infernix.ProcessIdentity
        Infernix.ProcessIdentity.Internal

common artifact-fixture
    default-language: GHC2021
    ghc-options:
        -Wall
        -Werror
        -fdiagnostics-color=never
    build-depends:
        aeson >=2.1 && <2.3,
        base >=4.18 && <4.23,
        base16-bytestring >=1.0 && <1.1,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.9,
        cryptohash-sha256 >=0.11 && <0.12,
        directory >=1.3 && <1.4,
        filelock >=0.1.1.9 && <0.2,
        filepath >=1.4 && <1.6,
        text >=2.0 && <2.2,
        unix >=2.8 && <2.9
    other-modules:
        Infernix.Cluster.LifecycleLock
        Infernix.Engines.Artifact
        Infernix.Engines.Artifact.Capability
        Infernix.Engines.Artifact.Identity
        Infernix.Engines.Artifact.Internal
        Infernix.Engines.Artifact.Loader
        Infernix.Engines.Artifact.Recipe
        Infernix.Engines.Artifact.Snapshot
        Infernix.Engines.Artifact.Target
        Infernix.Engines.MaterializationLock
        Infernix.Engines.MaterializationLock.Internal
        Infernix.Error

common artifact-capability-fixture
